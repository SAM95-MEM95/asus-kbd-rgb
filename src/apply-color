#!/bin/bash
set -euo pipefail

LED=/sys/class/leds/asus::kbd_backlight
HID=/usr/bin/hidapitester

[[ $# -eq 3 ]] || exit 2
for value in "$@"; do
    [[ "$value" =~ ^[0-9]{1,3}$ ]] && (( value <= 255 )) || exit 2
done
[[ -e "$LED/kbd_rgb_mode" ]] || exit 1

# Розбудити контролер, якщо hidapitester встановлений.
if [[ -x "$HID" ]]; then
    "$HID" --vidpid 0B05/19B6 --open --send-feature 70,1 --close >/dev/null
fi

printf '1 0 %s %s %s 0\n' "$1" "$2" "$3" > "$LED/kbd_rgb_mode"
printf '3\n' > "$LED/brightness"
